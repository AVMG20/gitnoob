{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitnoob",
  "version": "0.4.7",
  "identifier": "dev.gitnoob.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4783",
    "beforeBuildCommand": "npm run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gitnoob",
        "width": 1680,
        "height": 1040,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 21 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AVMG20/gitnoob/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRUQyN0FEQUMyM0NENTMKUldSVHpTT3NyU2Z0bjIrc0Uva0QzVitySjBuYzVqQzJYZlQvNHFmK3NMME9LTEtodkw2K3VPTkgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
